# ===== Cisco AnyConnect / openconnect =====
# VPN gateway address (host only, no scheme)
VPN_SERVER=vpn.example.com

# Login used in the ASA form. NOT the certificate CN: the ASA asks for
# username and PIN separately and picks the certificate on its own.
# Leaving this empty makes the server answer 401.
VPN_USER=jdoe

# Static PIN (the second field of the form)
VPN_PIN=0000

# Passphrase of the .p12 container (NOT the PIN)
P12_PASSPHRASE=change-me

# ===== proxy authentication =====
# letters and digits only: this value ends up inside a proxy URL
PROXY_USER=vpn
PROXY_PASS=change-me-strong

# ===== proxy ports =====
# Same numbers inside and outside the container. Change only if they clash.
#   1082 — HTTP CONNECT only
#   1083 — SOCKS5 only
#   1084 — auto (SOCKS5 or HTTP, detected per connection)
SOCKS_PORT=1083
HTTP_PORT=1082
AUTO_PORT=1084

# ===== port publishing =====
# LAN address of the host on which the proxies listen. Keep 127.0.0.1 if the
# code runs on the same host only.
BIND_IP=192.168.1.50

# ===== DNS =====
# home network resolver
HOME_DNS=192.168.1.1
# corporate resolvers, comma separated (reachable only through the tunnel)
CORP_DNS=10.0.0.53,10.0.0.54
# domains resolved through the corporate DNS (comma separated)
CORP_DOMAINS=example.com,corp.example.com

# ===== network =====
# home subnets, comma separated. Fill this in when the server pushes a range
# that covers your LAN: these destinations are routed back out locally instead
# of into the tunnel
LAN_NETS=192.168.1.0/24

# ===== healthcheck =====
# internal address used to verify the corporate route sits in tun0.
# when empty, any route through tun0 is accepted
HEALTHCHECK_CORP_IP=10.0.0.1

# ===== reconnect behaviour =====
# wait this long when the ASA reports an exhausted IP pool
POOL_BACKOFF=300
